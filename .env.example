# ==============================================================================
# SlotChef Backend Environment Configuration (Template)
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# ==============================================================================

# --- Django Core ---
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Database: Supabase Cloud PostgreSQL (Primary) ---
# SlotChef uses Supabase strictly as managed PostgreSQL; Django owns all schema,
# auth, scheduling, and business logic.
#
# Connection method guidance:
# 1) Direct connection (IPv6, or IPv4 with Supabase IPv4 add-on) - best for
#    Django migrations (`migrate`) and IPv6-capable persistent servers:
#    DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# 2) Supavisor Session Pooler (IPv4-compatible, port 5432) - best for persistent
#    Django + Celery workers running in IPv4-only environments:
#    DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# 3) Portable PostgreSQL (any other Postgres provider / local fallback if needed):
#    DATABASE_URL=postgresql://slotchef:slotchef@localhost:5432/slotchef?sslmode=disable
#
# Note: Avoid Transaction Pooler (port 6543) as primary DB for Django because
# Phase 5 locking/migrations require session semantics.
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Optional discrete PostgreSQL variables (used only if DATABASE_URL is unset)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_HOST=db.[PROJECT-REF].supabase.co
POSTGRES_PORT=5432

# Connection pooling & SSL tuning
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true
DB_CONNECT_TIMEOUT=10
DB_DISABLE_SERVER_SIDE_CURSORS=false

# Optional dedicated test database URL (recommended for CI/automated tests)
# If unset, Django uses the default database's test database (`test_<name>`).
TEST_DATABASE_URL=

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set true for local/sync development without running a Celery worker
CELERY_TASK_ALWAYS_EAGER=true

# --- OR-Tools CP-SAT Scheduler ---
SOLVER_TIME_LIMIT_SECONDS=5.0
DEFAULT_TRANSITION_MINUTES=5
SCHEDULER_MAX_RETRIES=3

# --- Auth & API Policy ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
IDEMPOTENCY_TTL_HOURS=24

